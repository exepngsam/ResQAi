# DISASTERIQ Environment Variables Template

# Backend
PORT=8000
HOST=0.0.0.0
DATABASE_URL=postgresql://disasteriq:disasteriq_pass@localhost:5432/disasteriq_db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your_secure_jwt_secret_hex
STORAGE_BUCKET=disasteriq-aerial-imagery
MODE=DEMO_SIMULATION

# AI / LLM Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# LIVE GIS & MAP PROVIDER API KEYS
# CartoDB Dark Matter operates natively without any API key
MAP_TILE_PROVIDER=CARTO_DARK_MATTER

# Mapbox Access Token (Optional: https://account.mapbox.com/)
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Google Maps Platform API Key (Optional: https://mapsplatform.google.com/maps-demo-key)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeatherMap API Key (Optional: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA FIRMS API Key (Optional: https://firms.modaps.eosdis.nasa.gov/api/)
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
